<?xml version="1.0" encoding="utf-8"?>
<!--
    An ear drawn as two open strokes, with the probe's light sitting in the canal —
    the dot is what separates "camera in an ear" from a hearing-aid glyph.

    The group scale keeps the whole drawing inside the 72dp safe zone of the 108dp
    adaptive-icon canvas, so no launcher mask can clip the lobe.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:translateX="2">
        <path
            android:pathData="M66,32 C56,24 42,28 38,40 C34,52 38,60 40,68 C42,76 40,84 48,86 C54,88 58,84 58,78"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M60,45 C52,41 47,47 47,55 C47,61 51,64 53,67"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M52,57 C52,54.24 54.24,52 57,52 C59.76,52 62,54.24 62,57 C62,59.76 59.76,62 57,62 C54.24,62 52,59.76 52,57 Z"
            android:fillColor="#7FE3D6" />
    </group>
</vector>
